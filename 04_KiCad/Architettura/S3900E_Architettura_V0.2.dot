digraph Radio {
  graph [rankdir=LR, bgcolor="white", margin=0.12, pad=0.2, nodesep=0.35, ranksep=0.5, fontname="DejaVu Sans"];
  node [shape=box, style="rounded,filled", fillcolor="#eaf1f6", color="#54708a", fontname="DejaVu Sans", fontsize=11];
  edge [arrowsize=0.7, color="#3f5d73"];
  antenna [label="Antenna\n50 ohm", fillcolor="#e8f5ed"];
  sw [label="Commutatore\nRX/TX"];
  pre [label="Preselettori\n6 bande"];
  atten [label="Attenuatore\n0/10/20 dB"];
  lna [label="LNA + bypass"];
  mixer [label="Mixer bilanciato\nADE-1+ candidato"];
  if1 [label="FI1 10,695 MHz"];
  ssb [label="Filtri SSB 2,4 kHz\nBFO, prodotto, AGC"];
  amfm [label="FI2 455 kHz\nAM / FM, AGC"];
  aud [label="Audio analogico\nDSP disinseribile", fillcolor="#e8f5ed"];
  pll [label="TCXO 12,8MHz\nADF4351 Integer-N", fillcolor="#fff1d6"];
  lob [label="Filtro + buffer LO\n+7dBm al mixer", fillcolor="#fff1d6"];
  mcu [label="MCU\ncomandi + interlock", fillcolor="#fff1d6"];
  tx [label="Modulazione, mix TX\nPA, filtri armoniche", fillcolor="#fce7e7"];
  w1 [label="Coupler protezione PA", fillcolor="#fce7e7"];
  atu [label="ATU LC + bypass", fillcolor="#fce7e7"];
  w2 [label="Misura antenna\n(proposta)", fillcolor="#fce7e7"];
  antenna -> sw; sw -> atten -> pre -> lna -> mixer -> if1; if1 -> ssb -> aud; if1 -> amfm -> aud;
  pll -> lob -> mixer; mcu -> pll [style=dashed]; mcu -> atu [style=dashed]; mcu -> tx [style=dashed];
  tx -> w1 -> atu -> w2 -> sw;
  subgraph cluster_note {label="ARCHITETTURA DI STUDIO - NON SCHEMA ELETTRICO"; fontname="DejaVu Sans"; fontsize=10; color="#b3b3b3"; style="dashed";}
}
